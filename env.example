# JenAI Studio — optional environment overrides
# Copy this file to ".env" if you want to use it (cp env.example .env).
#
# The normal way to add keys is the in-app onboarding popup or Settings.
# These env vars are only for people who prefer files. If set, they seed the
# key store on first run (the GUI still wins after that).

# Server port (default 4317)
# PORT=4317

# Provider API keys (optional — the app runs and explains itself with zero keys)
# KIE_API_KEY=
# OXEN_API_KEY=

# Where local data lives (keys, history, generated files). Default: ~/.jenai-studio
# JENAI_DATA_DIR=
